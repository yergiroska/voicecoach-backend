# Copiar a `.env` y ajustar. Este archivo SÍ se versiona: no poner valores reales.

APP_NAME=VoiceCoach AI
APP_VERSION=0.1.0

# Firebase Auth — el Project ID es público, no es un secreto. Es el `aud`/`iss`
# esperado al verificar los ID tokens contra las claves públicas de Google.
# No se necesita clave privada de cuenta de servicio.
FIREBASE_PROJECT_ID=voicecoach-ai-9071f

# Opcionales (tienen default en app/core/config.py):
# FIREBASE_CLOCK_SKEW_SECONDS=10
# FIREBASE_CERTS_CACHE_TTL_SECONDS=3600