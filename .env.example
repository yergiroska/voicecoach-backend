# Copiar a `.env` y ajustar. Este archivo SÍ se versiona: no poner valores reales.

APP_NAME=VoiceCoach AI
APP_VERSION=0.1.0

# Firebase Auth — el Project ID es público, no es un secreto. Es el `aud`/`iss`
# esperado al verificar los ID tokens contra las claves públicas de Google.
# No se necesita clave privada de cuenta de servicio.
FIREBASE_PROJECT_ID=voicecoach-ai-9071f

# Opcionales (tienen default en app/core/config.py):
# FIREBASE_CLOCK_SKEW_SECONDS=10
# FIREBASE_CERTS_CACHE_TTL_SECONDS=3600

# Almacenamiento local de las grabaciones de audio. Todo opcional (tiene default
# en app/core/config.py); se muestran los defaults como referencia.
# Ruta de la carpeta donde se guardan los audios subidos a POST /recordings.
# Si es relativa se resuelve desde la raíz del repo, no desde el CWD.
# AUDIO_STORAGE_DIR=storage/audio
# Tamaño máximo por grabación, en bytes. 25 MB: ~25 min de m4a/AAC de
# expo-audio y es también el límite de archivo de la API de Groq Whisper.
# MAX_AUDIO_UPLOAD_BYTES=26214400

# ---- Groq (transcripción con Whisper) ----
#
# >>> SECRETO <<< Es la única variable de este archivo que NO es pública: el
# resto (Project ID de Firebase, rutas, límites) puede versionarse sin riesgo.
# Déjala VACÍA aquí y pon el valor real solo en tu `.env` local (gitignorado).
#
# Se obtiene en https://console.groq.com/keys y tiene el formato `gsk_...`.
# Sin ella la app arranca igual (con un WARNING) y /health y /me funcionan con
# normalidad, pero POST /recordings responde 503. Ojo: dejar `GROQ_API_KEY=`
# vacía en el `.env` cuenta como no configurada, no como clave inválida.
GROQ_API_KEY=

# Opcionales (tienen default en app/core/config.py):
# Modelo de transcripción. `whisper-large-v3` prioriza precisión (10,3% WER);
# `whisper-large-v3-turbo` es más rápido y barato con algo menos de precisión
# (12% WER). Se eligió el primero porque el análisis de muletillas y ritmo
# depende de la calidad de la transcripción.
# GROQ_WHISPER_MODEL=whisper-large-v3
# Segundos antes de cortar la llamada a Groq. Con transcripción síncrona el
# móvil espera esta respuesta: sin timeout una llamada colgada bloquearía el
# request. 120 s cubre subir y transcribir un audio cercano al límite de 25 MB.
# GROQ_TIMEOUT_SECONDS=120
